# Copy this file to .env and fill in your own key:
#     cp .env.example .env
#
# The agent reaches gpt-6-luna through the Portkey gateway. This is the only
# secret the project needs. Never commit the filled-in .env.

PORTKEY_API_KEY=your-portkey-api-key-here

# Optional. Defaults to gpt-6-luna; the agent refuses to start on any other model.
# CAMPUS_CUSTOMS_AGENT_MODEL=gpt-6-luna
